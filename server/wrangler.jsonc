// Takkar API + admin console. Free tier: Workers (100k requests/day) + D1 (5 GB).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "takkar-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/admin", "/admin/api/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "takkar",
      // Replace with the id printed by: npx wrangler d1 create takkar
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
  // Secrets (set with: npx wrangler secret put NAME):
  //   TOTP_KEY            32 random bytes, base64url  (required)
  //   CF_ACCOUNT_ID, CF_API_TOKEN       optional, live free-tier usage
  //   RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET  optional, refunds through Razorpay
}
