// Takkar API + admin console. Free tier: Workers (100k requests/day) + D1 (5 GB).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "takkar-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/admin", "/admin/api/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "takkar",
      // Live beta database (APAC), created 2026-10-20
      "database_id": "83e8fd2c-3008-44e9-a7b0-a840560b3393",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Firebase project for Google and phone sign-in. Empty: the app offers guest play only.
    "FIREBASE_PROJECT_ID": "",
    // For sign-in on the web app: from Firebase > Project settings > Your apps > Web app.
    "FIREBASE_WEB_API_KEY": "",
    "FIREBASE_WEB_APP_ID": "",
    "FIREBASE_AUTH_DOMAIN": "",
    // Where "Update available" in the app points.
    "APP_UPDATE_URL": "https://takkar.vercel.app/beta"
  },
  "observability": { "enabled": true }
  // Secrets (set with: npx wrangler secret put NAME):
  //   TOTP_KEY            32 random bytes, base64url  (required)
  //   CF_ACCOUNT_ID, CF_API_TOKEN       optional, live free-tier usage
  //   RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET  optional, refunds through Razorpay
}
