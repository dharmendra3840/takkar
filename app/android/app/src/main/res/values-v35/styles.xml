<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 and later always draw apps edge to edge: the status and navigation bar colours
         below are ignored and the bars show the dark window background (the WebView is kept
         clear of them), so their icons must be light to be seen. Older versions use values/. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#0A0D28</item>
    </style>
</resources>
